# ============================================================
# config/.env — Environment variables for Obsidian NAS Sync
# ============================================================
# COPY this file to config/.env and fill in the values.
# The .env file is NEVER pushed to GitHub (see .gitignore).
# ============================================================

# CouchDB admin account (only used for administration)
COUCHDB_ADMIN_USER=admin
COUCHDB_ADMIN_PASSWORD=change-to-a-strong-password

# Password per vault user.
# The variable names are referenced in scripts/setup-users.sh — keep them in sync.
USER1_PASSWORD=change-to-a-strong-password
USER2_PASSWORD=change-to-a-strong-password
SHARED_PASSWORD=change-to-a-strong-password

# Cloudflare Tunnel Token
# Get this from: Zero Trust → Networks → Tunnels → [your tunnel] → Configure → Token
CLOUDFLARE_TUNNEL_TOKEN=paste-the-token-here

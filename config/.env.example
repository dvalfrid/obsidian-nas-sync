# ============================================================
# config/.env — Miljövariabler för Obsidian NAS Sync
# ============================================================
# KOPIERA den här filen till config/.env och fyll i värdena.
# Filen .env pushas ALDRIG till GitHub (se .gitignore).
# ============================================================

# CouchDB admin-konto (används bara för administration)
COUCHDB_ADMIN_USER=admin
COUCHDB_ADMIN_PASSWORD=BYTA_TILL_STARKT_LOSENORD

# Individuella vault-användare
DANIEL_PASSWORD=BYTA_TILL_STARKT_LOSENORD
LINDA_PASSWORD=BYTA_TILL_STARKT_LOSENORD
SHARED_PASSWORD=BYTA_TILL_STARKT_LOSENORD

# Cloudflare Tunnel Token
# Hämtas från: Zero Trust → Networks → Tunnels → [din tunnel] → Configure → Token
CLOUDFLARE_TUNNEL_TOKEN=KLISTRA_IN_TOKEN_HAR
